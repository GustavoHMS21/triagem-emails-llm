# Copie para .env e ajuste. O .env nunca vai para o Git.

# LLM local via Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen3:8b
LLM_TIMEOUT_S=300
LLM_TENTATIVAS=2

# PostgreSQL (mesmos valores do docker-compose.yml)
# Use 127.0.0.1, não localhost: no Windows, localhost tenta IPv6 primeiro e a
# conexão com o Docker fica pendurada ~2 min antes de cair para IPv4.
DATABASE_URL=postgresql://triagem:triagem@127.0.0.1:5433/triagem

# Dados de referência
CONDOMINIOS_CSV=data/condominios.csv
GESTORES_CSV=data/gestores.csv
